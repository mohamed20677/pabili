{
  "expo": {
    "name": "Pabili",
    "slug": "pabili-ph",
    "version": "1.5.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "android"
    ],
    "icon": "./assets/icon.png",
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#0E7C5B"
    },
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#0E7C5B",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.pabili.ph",
      "versionCode": 23,
      "permissions": [
        "INTERNET",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E7C5B"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Pabili uses your location to match nearby stores and, while you are online as a courier, to share your live position for active deliveries \u2014 even when the screen is locked.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pabili needs your photos to attach pictures to orders and your profile.",
          "cameraPermission": "Pabili needs the camera to take product, pickup and delivery photos."
        }
      ]
    ]
  }
}

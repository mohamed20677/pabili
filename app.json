{
  "expo": {
    "name": "Pabili",
    "slug": "pabili-ph",
    "version": "1.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": ["android"],
    "icon": "./assets/icon.png",
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#0E7C5B"
    },
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#0E7C5B",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.pabili.ph",
      "versionCode": 11,
      "permissions": [
        "INTERNET",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "REPLACE_WITH_YOUR_GOOGLE_MAPS_API_KEY"
        },
        "location": {
          "androidMode": "highAccuracy"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E7C5B"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Pabili to use your location to assign the right courier and show nearby stores."
        }
      ]
    ]
  }
}
